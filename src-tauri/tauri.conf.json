{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NothingAppX",
  "version": "0.1.0",
  "identifier": "app.nothingappx",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:8790",
    "beforeDevCommand": "python servidor.py 8790",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NothingAppX",
        "width": 420,
        "height": 780,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
